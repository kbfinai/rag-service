# Application
APP_NAME=rag-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_service
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Vector Database (pgvector uses same DATABASE_URL)
EMBEDDING_DIMENSION=1536

# =============================================================================
# Embedding Providers
# =============================================================================

# OpenAI (default provider)
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# HuggingFace (optional - for API embeddings)
HUGGINGFACE_API_KEY=

# Ollama (optional - for local embeddings)
OLLAMA_BASE_URL=http://localhost:11434

# Default provider settings
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# LLM Configuration
# =============================================================================

LLM_MODEL=gpt-4o-mini

# =============================================================================
# Chunking Settings
# =============================================================================

CHUNK_SIZE=512
CHUNK_OVERLAP=50
DEFAULT_CHUNKING_STRATEGY=fixed

# =============================================================================
# RAG Settings
# =============================================================================

TOP_K=5
MIN_SIMILARITY=0.5

# =============================================================================
# File Upload Settings
# =============================================================================

MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","txt","docx","md","csv","xlsx","xls","html","htm","rtf"]

# =============================================================================
# Authentication
# =============================================================================

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# RBAC Settings
# =============================================================================

ENABLE_PUBLIC_DOCUMENTS=false
DEFAULT_USER_ROLE=viewer

# =============================================================================
# CORS
# =============================================================================

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
